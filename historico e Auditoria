<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Gestão de Atendimentos Psicológicos</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#F6F1E9;--sf:#FBF8F3;--tx:#3B2F26;--mu:#6F5F52;--br:#4A3828;--gr:#4A7556;--ln:#E6DCCD;--bt:#EFE6D8;--wn:#F6E6C8;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1E1914;--sf:#2A231C;--tx:#EFE6D8;--mu:#B8A998;--br:#D8C7AE;--gr:#7FB08B;--ln:#3A3026;--bt:#3A3026;--wn:#4A3A1C}}
:root[data-theme="dark"]{--bg:#1E1914;--sf:#2A231C;--tx:#EFE6D8;--mu:#B8A998;--br:#D8C7AE;--gr:#7FB08B;--ln:#3A3026;--bt:#3A3026;--wn:#4A3A1C}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font-family:'DM Sans',system-ui,sans-serif;line-height:1.5}
h1,h2,h3{font-family:'Fraunces',Georgia,serif;margin:0}
header{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--ln)}
.brand{font-family:'Fraunces',Georgia,serif;font-size:20px;font-weight:600}
.seg{display:flex;background:var(--bt);border-radius:12px;padding:4px;gap:4px}
button{font:inherit;cursor:pointer;min-height:44px;border-radius:12px;border:0;padding:0 16px;font-weight:600;background:var(--bt);color:var(--tx)}
button.on{background:var(--br);color:var(--bg)}
button.pr{background:var(--gr);color:#fff}
button.dg{background:transparent;border:1.5px solid #C98F88;color:#B0463C}
nav{display:flex;gap:8px;flex-wrap:wrap;padding:12px 20px}
main{max-width:920px;margin:0 auto;padding:12px 20px 48px;display:flex;flex-direction:column;gap:18px}
.card{background:var(--sf);border-radius:18px;padding:20px;border:1px solid var(--ln)}
.col{display:flex;flex-direction:column;gap:10px}
.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:6px 12px;font-size:13px;font-weight:600;background:var(--bt)}
.dot{width:8px;height:8px;border-radius:50%}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px}
.num{font-family:'Fraunces',serif;font-size:30px}
.mu{color:var(--mu);font-size:14px}
.warn{background:var(--wn);border-radius:12px;padding:12px 16px}
input,textarea,select{font:inherit;min-height:44px;border-radius:10px;border:1px solid var(--ln);background:var(--bg);color:var(--tx);padding:8px 12px;width:100%}
.item{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 0;border-bottom:1px solid var(--ln)}
</style>
</head>
<body>
<header><div class="brand">[Nome do app]</div>
<div class="seg" role="group" aria-label="Alternar área"><button id="rp">Área do paciente</button><button id="rt">Área da terapeuta</button></div></header>
<nav id="nav" aria-label="Menu"></nav>
<main id="app"></main>
<script src="js/01-comum.js"></script>
<script src="js/02-paciente-inicio.js"></script>
<script src="js/03-notificacoes.js"></script>
<script src="js/04-terapeuta-inicio.js"></script>
<script src="js/05-terapeuta-pacientes.js"></script>
<script src="js/06-historico.js"></script>
<script src="js/07-iniciar.js"></script>
</body>
</html>
