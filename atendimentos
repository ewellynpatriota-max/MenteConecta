var S={role:'p',tab:'home',st:'ther',when:'Quarta-feira, 07/10 · 15:00',late:'',form:null,health:false,notes:[],log:[]};
var ST={ther:['Aguardando confirmação da terapeuta','#B7791F'],pac:['Aguardando confirmação do paciente','#B7791F'],conf:['Confirmado','#4A7556'],late:['Atraso informado','#C0601E'],resched:['Reagendamento solicitado','#3F6FA8'],cp:['Cancelado pelo paciente','#B0463C'],ct:['Cancelado pela terapeuta','#B0463C']};
function now(){return new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}
function act(who,what,to,msg,ns){var prev=ST[S.st][0];S.st=ns||S.st;S.log.unshift({t:now(),who:who,what:what,from:prev,to:ST[S.st][0]});if(to)S.notes.unshift({to:to,t:now(),msg:msg});render()}
function pill(k){var s=ST[k];return '<span class="pill"><span class="dot" style="background:'+s[1]+'"></span>'+s[0]+'</span>'}
function btn(id,label,cls){return '<button id="'+id+'" class="'+(cls||'')+'">'+label+'</button>'}
function patient(){
 if(S.tab==='notes')return notes('p');
 var h='<h1>Olá, Maria!</h1><div class="card col"><div class="mu">PRÓXIMO ATENDIMENTO</div><h2>'+S.when+'</h2><div class="mu">50 minutos</div><div>'+pill(S.st)+(S.late?' <span class="mu">'+S.late+'</span>':'')+'</div>';
 if(S.st==='ther')h+='<p class="mu">Aguardando a terapeuta confirmar a disponibilidade. Você será avisada em seguida.</p>';
 else if(S.st==='cp'||S.st==='ct')h+='<p class="mu">Este atendimento foi cancelado.</p>';
 else if(S.form==='late')h+='<div class="col"><b>Quanto tempo de atraso?</b>'+['Até 5 minutos','5–10 minutos','10–20 minutos','Mais de 20 minutos'].map(function(x,i){return btn('l'+i,x)}).join('')+btn('x','Voltar')+'</div>';
 else if(S.form==='cancel')h+='<div class="col"><b>Você tem certeza de que deseja cancelar este atendimento?</b>'+btn('cc','Sim, cancelar','dg')+btn('x','Voltar')+'</div>';
 else if(S.form==='re')h+='<div class="col"><b>Solicitar reagendamento</b><label>Dias preferidos<input id="rd" placeholder="Ex.: terça ou quinta"></label><label>Horários preferidos<input id="rh" placeholder="Ex.: depois das 16h"></label><label>Motivo (opcional)<textarea id="rm" rows="2"></textarea></label>'+btn('rs','Enviar solicitação','pr')+btn('x','Voltar')+'</div>';
 else if(S.st==='resched')h+='<p class="mu">Sua solicitação foi enviada. A terapeuta responderá com um novo horário.</p>';
 else h+='<div class="col">'+(S.st==='pac'?btn('cf','Confirmar atendimento','pr'):'')+btn('lt','Vou me atrasar')+btn('rq','Solicitar reagendamento')+btn('np','Não poderei comparecer','dg')+'</div>';
 return h+'</div><p class="mu">Seu atendimento nunca é cancelado automaticamente por falta de resposta ou por atraso.</p>'}
function notes(w){var l=S.notes.filter(function(n){return n.to===w});return '<h1>Notificações</h1><div class="card">'+(l.length?l.map(function(n){return '<div class="item"><span>'+n.msg+'</span><span class="mu">'+n.t+'</span></div>'}).join(''):'<span class="mu">Nenhuma notificação.</span>')+'</div>'}
function therapist(){
 if(S.tab==='notes')return notes('t');
 if(S.tab==='log')return '<h1>Histórico e auditoria</h1><div class="card">'+(S.log.length?S.log.map(function(e){return '<div class="item"><span><b>'+e.who+'</b> — '+e.what+'<br><span class="mu">'+e.from+' → '+e.to+'</span></span><span class="mu">'+e.t+'</span></div>'}).join(''):'<span class="mu">Nenhuma alteração ainda.</span>')+'</div>';
 if(S.tab==='pts')return '<h1>Maria Silva</h1><div class="card col"><b>Dados pessoais</b><span>Nome social: Maria · 28 anos · 12/03/1998</span><span>E-mail: maria@email.com</span><span>Cor/raça: [informação]</span></div><div class="card col"><b>Informações de saúde</b><span class="mu">Acesso restrito à terapeuta autorizada. Nunca aparece na agenda nem em notificações.</span>'+(S.health?'<span>CID: [informação cadastrada]</span><span>Medicamentos: [informação]</span><span>Alergias: [informação]</span>'+btn('hh','Ocultar'):btn('sh','Mostrar informações de saúde'))+'</div>';
 var n={conf:S.st==='conf'?1:0,pend:(S.st==='ther'||S.st==='pac')?1:0,late:S.st==='late'?1:0};
 var h='<h1>Olá, [nome]</h1><div class="grid"><div class="card"><div class="num">3</div><div class="mu">atendimentos hoje</div></div><div class="card"><div class="num">'+(2+n.conf)+'</div><div class="mu">confirmados</div></div><div class="card"><div class="num">'+(1+n.pend)+'</div><div class="mu">aguardando</div></div><div class="card"><div class="num">'+(1+n.late)+'</div><div class="mu">atrasos</div></div></div>';
 if(S.st==='pac')h+='<div class="warn">Maria ainda não confirmou o atendimento.</div>';
 if(S.st==='resched')h+='<div class="warn">Maria solicitou reagendamento: '+(S.pref||'sem preferências')+'.</div>';
 h+='<h2>Atendimento em foco</h2><div class="card col"><b>Maria Silva — '+S.when+'</b><div>'+pill(S.st)+(S.late?' <span class="mu">'+S.late+'</span>':'')+'</div><div class="row">';
 if(S.st==='ther')h+=btn('tc','Confirmar minha disponibilidade','pr');
 if(S.st==='pac')h+=btn('rm2','Enviar novo lembrete')+btn('mc','Confirmar manualmente');
 if(S.st==='resched')h+=btn('of','Oferecer quinta, 08/10 · 15:00','pr');
 if(S.st!=='cp'&&S.st!=='ct')h+=btn('ab','Avisar indisponibilidade (cancelar)','dg');
 h+='</div></div><h2>Hoje</h2><div class="card"><div class="item"><span>09:00 — Maria Silva</span>'+pill(S.st)+'</div><div class="item"><span>10:00 — João Santos</span>'+pill('pac')+'</div><div class="item"><span>11:00 — Ana Costa</span>'+pill('late')+'</div></div>';
 return h}
function render(){
 var p=S.role==='p';document.getElementById('rp').className=p?'on':'';document.getElementById('rt').className=p?'':'on';
 var tabs=p?[['home','Início'],['notes','Notificações']]:[['home','Início'],['pts','Pacientes'],['notes','Notificações'],['log','Histórico']];
 document.getElementById('nav').innerHTML=tabs.map(function(t){return '<button data-t="'+t[0]+'" class="'+(S.tab===t[0]?'on':'')+'">'+t[1]+'</button>'}).join('');
 document.getElementById('app').innerHTML=p?patient():therapist()}
document.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;var i=b.id,t=b.dataset.t;
 if(t){S.tab=t;return render()}
 if(i==='rp'){S.role='p';S.tab='home';return render()}if(i==='rt'){S.role='t';S.tab='home';return render()}
 if(i==='x'){S.form=null;return render()}
 if(i==='lt'){S.form='late';return render()}if(i==='np'){S.form='cancel';return render()}if(i==='rq'){S.form='re';return render()}
 if(i&&i[0]==='l'&&i.length===2){S.form=null;S.late=b.textContent;return act('Paciente','informou atraso ('+S.late+')','t','Maria informou atraso: '+S.late+'.','late')}
 if(i==='cf'){return act('Paciente','confirmou atendimento','t','Maria confirmou o atendimento.','conf')}
 if(i==='cc'){S.form=null;return act('Paciente','cancelou atendimento','t','Maria cancelou o atendimento.','cp')}
 if(i==='rs'){S.pref=[document.getElementById('rd').value,document.getElementById('rh').value].filter(Boolean).join(', ');S.form=null;return act('Paciente','solicitou reagendamento','t','Maria solicitou reagendamento.','resched')}
 if(i==='tc')return act('Terapeuta','confirmou disponibilidade','p','Confirme seu atendimento de '+S.when+'.','pac');
 if(i==='rm2')return act('Terapeuta','enviou novo lembrete','p','Lembrete: confirme seu atendimento.');
 if(i==='mc')return act('Terapeuta','confirmou manualmente','p','Seu atendimento foi atualizado.','conf');
 if(i==='of'){S.when='Quinta-feira, 08/10 · 15:00';return act('Terapeuta','ofereceu novo horário','p','Novo horário proposto: '+S.when+'. Confirme.','pac')}
 if(i==='ab')return act('Terapeuta','avisou indisponibilidade','p','Seu atendimento precisará ser cancelado.','ct');
 if(i==='sh'){S.health=true;return render()}if(i==='hh'){S.health=false;return render()}});
render();
